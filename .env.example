# ─────────────────────────────────────────────────────────────
# Claves de API — Binance TESTNET
# Generalas en: https://testnet.binance.vision
# IMPORTANTE: NO uses tus claves de mainnet (cuenta real) acá.
# Permiso: trade SÍ, retiro (withdrawal) NO.
# ─────────────────────────────────────────────────────────────
BINANCE_API_KEY=tu_api_key_de_testnet_aca
BINANCE_API_SECRET=tu_api_secret_de_testnet_aca

# ─────────────────────────────────────────────────────────────
# Configuración del bot
# En esta etapa, USE_TESTNET DEBE ser true. Mainnet está bloqueado por código.
# ─────────────────────────────────────────────────────────────
USE_TESTNET=true
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1h

# Estrategia (research): SMA | EMA, y sus medias rápida/lenta.
STRATEGY=SMA
FAST=20
SLOW=50

# ─────────────────────────────────────────────────────────────
# Persistencia (CRÍTICO en Railway)
# El filesystem de Railway es EFÍMERO: sin esto, journal + estado se pierden
# en cada redeploy. Montá un Volume y apuntá DATA_DIR a su mount path.
# En local podés dejarlo en ./data.
# ─────────────────────────────────────────────────────────────
DATA_DIR=./data

# ─────────────────────────────────────────────────────────────
# Alertas por Telegram (opcional). Si faltan, el notifier queda deshabilitado.
# Token de @BotFather; chat_id del chat/grupo destino.
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

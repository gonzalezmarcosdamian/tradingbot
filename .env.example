# ─────────────────────────────────────────────────────────────
# Claves de API — Binance TESTNET
# Generalas en: https://testnet.binance.vision
# IMPORTANTE: NO uses tus claves de mainnet (cuenta real) acá.
# ─────────────────────────────────────────────────────────────
BINANCE_API_KEY=tu_api_key_de_testnet_aca
BINANCE_API_SECRET=tu_api_secret_de_testnet_aca

# ─────────────────────────────────────────────────────────────
# Configuración del bot
# En la etapa 1, USE_TESTNET DEBE ser true. Mainnet está bloqueado.
# ─────────────────────────────────────────────────────────────
USE_TESTNET=true
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1h
